# Supabase project credentials (safe to expose client-side; the anon key
# is protected by Row Level Security policies in supabase/schema.sql)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: football-data.org API key, used by src/lib/fixturesSource.js
# to fetch real fixtures/results/standings once matchday predictions and
# projected standings are wired up to live data. Until this is set, the
# app falls back to stubFixturesSource (empty data, no crashes) -- see
# fixturesSource.js for the commented-out real implementation.
# Get a free key at https://www.football-data.org/client/register
VITE_FOOTBALL_DATA_API_KEY=
